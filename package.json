{
  "name": "controle-impressoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && esbuild ts/main.ts --bundle --format=iife --target=es2017 --minify --outfile=dist/app.js",
    "watch": "esbuild ts/main.ts --bundle --format=iife --target=es2017 --sourcemap --outfile=dist/app.js --watch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20",
    "chart.js": "^4.4.0",
    "esbuild": "^0.25.0",
    "jspdf": "^2.5.2",
    "sweetalert2": "^11.14.5",
    "typescript": "^5"
  }
}
